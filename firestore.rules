rules_version = '2';

// Data model
//   users/{uid}                       profile + role ('customer' | 'admin')
//   users/{uid}/cartItems/{productId} the user's shopping cart
//   users/{uid}/addresses/{addressId} the user's address book
//   products/{productId}              catalog, public read, admin write
//   categories/{categoryId}           catalog categories, public read, admin write
//   orders/{orderId}                  placed by customers, managed by admins
//   images/{imageId}                  Base64 photos kept out of other documents
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // New accounts always start as customers. Admins are promoted from the Firebase console.
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      // Users can edit their own profile but never their own role.
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /cartItems/{productId} {
        allow read, write: if isOwner(uid);
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Customers may only lower the stock, which checkout does when an order is placed.
      // A production app would move this into a Cloud Function (paid plan).
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
      );
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Customers can only place their own orders, and every order starts as pending.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      // Only admins move an order through its status flow.
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /images/{imageId} {
      allow read: if isSignedIn();
      // Keep each Base64 image well under Firestore's 1 MiB document limit.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
