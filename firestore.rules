rules_version = '2';

// Data model
//   users/{uid}                       profile + role ('customer' | 'admin')
//   users/{uid}/cartItems/{productId} the user's shopping cart
//   users/{uid}/addresses/{addressId} the user's address book
//   users/{uid}/wishlist/{productId}  products the user saved for later
//   products/{productId}              catalog, public read, admin write
//   products/{productId}/reviews/{uid} customer reviews, one per customer
//   categories/{categoryId}           catalog categories, public read, admin write
//   orders/{orderId}                  placed by customers, managed by admins
//   images/{imageId}                  Base64 photos kept out of other documents
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // New accounts always start as customers. Admins are promoted from the Firebase console.
      allow create: if isOwner(uid) && request.resource.data.role == 'customer';
      // Nobody changes roles from the app, not even admins: the demo admin account
      // is shared publicly. Roles are managed in the Firebase console.
      allow update: if (isOwner(uid) || isAdmin()) && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /cartItems/{productId} {
        allow read, write: if isOwner(uid);
      }

      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(uid);
      }
    }

    // True when this write cancels a pending order that belongs to the caller.
    function cancelsOwnPendingOrder(orderId) {
      let path = /databases/$(database)/documents/orders/$(orderId);
      return get(path).data.userId == request.auth.uid
        && get(path).data.status == 'pending'
        && getAfter(path).data.status == 'cancelled';
    }

    // Customers can touch three things on a product, each only alongside the
    // action that justifies it. A production app would move these into
    // Cloud Functions (paid plan) and check exact quantities.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (
        // Checkout lowers the stock.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
        )
        // Cancelling your own pending order puts the stock back.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'restockedByOrder'])
          && request.resource.data.stock > resource.data.stock
          && cancelsOwnPendingOrder(request.resource.data.restockedByOrder)
        )
        // Posting a review updates the average rating once.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount'])
          && request.resource.data.reviewCount
            == resource.data.get('reviewCount', resource.data.get('reviews', []).size()) + 1
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && !exists(/databases/$(database)/documents/products/$(productId)/reviews/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/products/$(productId)/reviews/$(request.auth.uid))
        )
      ));

      // One review per customer per product, only after a delivered order, and final once posted.
      match /reviews/{reviewerId} {
        allow read: if true;
        allow create: if isOwner(reviewerId)
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 1000
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'delivered';
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Customers can only place their own orders, and every order starts as pending.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      // Admins move orders through the status flow. Customers may only cancel
      // their own order while it is still pending.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusUpdatedAt', 'cancelledBy', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /images/{imageId} {
      // Public, so guests browsing the catalog see uploaded product photos.
      allow read: if true;
      // Keep each Base64 image well under Firestore's 1 MiB document limit.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }
  }
}
